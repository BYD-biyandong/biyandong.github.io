@article{biExperimentalInvestigationEffects2025,
  title = {Experimental Investigation of Effects of Clay Content on Wave-Induced Failure of Loosely-Deposited Submarine Slopes},
  author = {Bi, Yandong and Zhou, Shu and Tan, Xiaolin and Guo, Zhen and Zhu, Chongqiang and Sun, Jin and Huang, Yu},
  year = 2025,
  month = dec,
  journal = {Engineering Geology},
  volume = {359},
  pages = {108446},
  issn = {0013-7952},
  doi = {10.1016/j.enggeo.2025.108446},
  urldate = {2025-11-12},
  abstract = {Wave-induced submarine slope failure and landslides threaten coastal communities and offshore infrastructure. In this study, large wave flume tests were conducted to study the effect of clay content (CC) on submarine slope instability under wave loadings. Excess pore water pressure (EPWP) and soil pressure (SP) distributions within a model submarine slope were measured, and the whole process of the model submarine slope losing stability was captured. The experimental results show that the shoulder part of the submarine clayey slope is the first place for liquefaction due to the wave shoaling effect. The peak value of EPWP within a given submarine clayey slope gradually increases vertically, however, the maximum peak EPWP occurs in the middle part of the slope horizontally because of wave scouring and subsequent sliding under reciprocating wave oscillations and gravity. Especially, the results indicated that the CC has a substantial impact on the response of EPWP. When the clayey particles materials are added to the silt, it becomes increasingly susceptible to liquefaction. However, the peak value of EPWP exhibits a nonlinear relationship with CC. There is a critical value, when the CC is greater than this value, the peak EPWP will be partially repressed, which means liquefaction resistance. A possible mechanism about this different susceptibility to liquefaction of the loosely-deposited silty-clay mixtures induced by wave loadings have been proposed: The filling and adhesion effects of fine clay particles influence the localized migration themselves, further influence the EPWP response. This study provides practical guidance for offshore infrastructure design in clay-rich seabeds.},
  keywords = {Clay content,Liquefaction,Pore water pressure response,Slope instability,Submarine slope},
  file = {/Volumes/expansionDisk/Zotero_References/storage/QDAFR3PC/Bi 等 - 2025 - Experimental investigation of effects of clay content on wave-induced failure of loosely-deposited s.pdf;/Volumes/expansionDisk/Zotero_References/storage/AYKYYIM9/S0013795225005423.html}
}
